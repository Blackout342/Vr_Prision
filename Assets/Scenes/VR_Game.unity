--- !u!114 &913602306
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 913602304}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "LA \xDALTIMA CELDA\n\nHas despertado dentro de una prisi\xF3n abandonada.\n\nNo
    recuerdas c\xF3mo llegaste aqu\xED, pero una cosa es clara:\nla salida est\xE1
    cerrada y nadie vendr\xE1 a ayudarte.\n\nLa cerradura principal no funciona sin
    energ\xEDa.\nPara abrirla, deber\xE1s encontrar las bater\xEDas escondidas\ny
    colocarlas en el lugar correcto.\n\nUn prisionero anterior intent\xF3 escapar
    antes que t\xFA.\nNo lo logr\xF3, pero dej\xF3 pistas ocultas en la celda.\n\nObserva
    cada pared.\nRevisa cada objeto.\nEscucha todos los sonidos.\n\nAlgunas respuestas
    no est\xE1n escritas.\nAlgunas pistas solo pueden o\xEDrse.\n\nSi escuchas con
    atenci\xF3n,\ntal vez la alcantarilla tenga algo que decirte.\nAc\xE9rcate a
    ella y presta atenci\xF3n.\n\nPero recuerda:\nel c\xF3digo de la caja fuerte
    no se encuentra en esta habitaci\xF3n.\n\nSigue las se\xF1ales en el orden correcto.\nSolo
    quien logre entender el mensaje oculto\npodr\xE1 activar la cerradura y escapar
    de esta prisi\xF3n."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
  m_sharedMaterial: {fileID: 2164040, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
